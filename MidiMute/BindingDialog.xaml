<Window x:Class="MidiMute.BindingDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Dialog.BindingNewTitle}" Height="500" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True">

    <Window.Resources>
        <Style x:Key="DialogFrameButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource BgHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource BgPrimary}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource BgSecondary}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="8,8,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="16,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="tray32.ico" Width="16" Height="16" Margin="0,0,8,0"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock x:Name="TitleBarLabel" Text="{DynamicResource Dialog.BindingNewTitle}"
                                   FontSize="13" FontWeight="Medium"
                                   Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Style="{StaticResource DialogFrameButton}"
                            Content="x"
                            ToolTip="{DynamicResource About.CloseTooltip}"
                            BorderThickness="0"
                            Padding="8,2"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Click="CancelButton_Click"/>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="24">

                <!-- Заголовок -->
                <TextBlock x:Name="DialogTitleLabel" Text="{DynamicResource Dialog.BindingNewHeader}" FontSize="15" FontWeight="Medium"
                           Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,20"/>

        <!-- Зона нажатия клавиши -->
        <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="8" Padding="16" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="{DynamicResource Dialog.MidiKeyTitle}" FontSize="10" FontWeight="Medium"
                           Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,10"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{DynamicResource BgSecondary}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="12,8">
                        <TextBlock x:Name="KeyLabel" Text="{DynamicResource Dialog.PressMidiKey}"
                                   FontSize="13" Foreground="{DynamicResource TextSecondary}"/>
                    </Border>
                    <Button Grid.Column="1" Content="{DynamicResource Dialog.Listen}" Margin="8,0,0,0"
                            Padding="12,8" Cursor="Hand"
                            ToolTip="{DynamicResource Dialog.ListenTooltip}"
                            Click="ListenButton_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource DialogPrimaryButtonText}"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
                <Border x:Name="ConflictWarningPanel"
                        Background="{DynamicResource BypassBg}"
                        BorderBrush="{DynamicResource BypassFg}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="10,7"
                        Margin="0,10,0,0"
                        Visibility="Collapsed">
                    <TextBlock x:Name="ConflictWarningLabel"
                               FontSize="12"
                               Foreground="{DynamicResource BypassFg}"
                               TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- Выбор действия -->
        <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="8" Padding="16" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="{DynamicResource Dialog.ActionTitle}" FontSize="10" FontWeight="Medium"
                           Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,10"/>
                <ComboBox x:Name="ActionCombo" FontSize="13"
                          SelectionChanged="ActionCombo_SelectionChanged">
                    <ComboBoxItem Content="{DynamicResource Action.MuteToggle}" Tag="MuteToggle" IsSelected="True"/>
                    <ComboBoxItem Content="{DynamicResource Action.Mute}" Tag="Mute"/>
                    <ComboBoxItem Content="{DynamicResource Action.Unmute}" Tag="Unmute"/>
                    <ComboBoxItem Content="{DynamicResource Action.HoldMute}" Tag="HoldMute"/>
                    <ComboBoxItem Content="{DynamicResource Action.HoldVolume}" Tag="HoldVolume"/>
                    <ComboBoxItem Content="{DynamicResource Action.VolumeUp}" Tag="VolumeUp"/>
                    <ComboBoxItem Content="{DynamicResource Action.VolumeDown}" Tag="VolumeDown"/>
                    <ComboBoxItem Content="{DynamicResource Action.SetVolume}" Tag="SetVolume"/>
                    <ComboBoxItem Content="{DynamicResource Action.RestartAudioDevice}" Tag="RestartAudioDevice"/>
                </ComboBox>

                <!-- Шаг громкости — показывается только для Volume -->
                <StackPanel x:Name="VolumeStepPanel" Visibility="Collapsed" Margin="0,12,0,0">
                    <TextBlock x:Name="VolumeValueTitle" Text="{DynamicResource Dialog.VolumeStepTitle}" FontSize="10" FontWeight="Medium"
                               Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="StepSlider" Grid.Column="0" Minimum="1" Maximum="25"
                                Value="10" TickFrequency="1" IsSnapToTickEnabled="True"
                                VerticalAlignment="Center"
                                ValueChanged="StepSlider_ValueChanged"/>
                        <TextBlock x:Name="StepLabel" Grid.Column="1" Text="10%"
                                   FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"
                                   VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Кнопки -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="{DynamicResource Common.Cancel}" Margin="0,0,6,0"
                    Padding="0,10" Cursor="Hand" Click="CancelButton_Click"
                    ToolTip="{DynamicResource Dialog.CancelBindingTooltip}">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="6" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource BgCard}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
            <Button Grid.Column="1" x:Name="SaveButton" Content="{DynamicResource Dialog.Add}" Margin="6,0,0,0"
                    Padding="0,10" Cursor="Hand" Click="AddButton_Click"
                    ToolTip="{DynamicResource Dialog.SaveBindingTooltip}">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                        <Setter Property="Foreground" Value="{DynamicResource DialogPrimaryButtonText}"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="6" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
            </StackPanel>
        </Grid>
    </Border>
</Window>

