<Window x:Class="MidiMute.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MidiMute" Height="600" Width="900"
        MinHeight="500" MinWidth="700"
        Background="{DynamicResource BgPrimary}"
        xmlns:local="clr-namespace:MidiMute"
        WindowStartupLocation="CenterScreen"
        Icon="tray32.ico"
        WindowStyle="None"
        AllowsTransparency="True">

    <Window.Resources>
        <!-- Стиль кнопки -->
        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Background"   Value="Transparent"/>
            <Setter Property="Foreground"   Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush"  Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"      Value="12,6"/>
            <Setter Property="FontSize"     Value="12"/>
            <Setter Property="Cursor"       Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource BgHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль элемента списка приложений -->
        <Style x:Key="AppListItem" TargetType="ListBoxItem">
            <Setter Property="Background"  Value="Transparent"/>
            <Setter Property="Foreground"  Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Padding"     Value="10,8"/>
            <Setter Property="Cursor"      Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6" Margin="4,2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource BgHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource BgCard}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsMidiActive}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль ListBox -->
        <Style x:Key="CleanListBox" TargetType="ListBox">
            <Setter Property="Background"        Value="Transparent"/>
            <Setter Property="BorderThickness"   Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>

        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource BgSecondary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Grid>
                            <Border x:Name="ItemBorder"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="4"
                                    Padding="{TemplateBinding Padding}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="CheckMark"
                                               Grid.Column="0"
                                               Text="&#x2713;"
                                               FontSize="12"
                                               Foreground="{DynamicResource AccentBrush}"
                                               Visibility="Collapsed"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Left"/>
                                    <ContentPresenter Grid.Column="1"
                                                      ContentSource="Header"
                                                      RecognizesAccessKey="True"
                                                      VerticalAlignment="Center"/>
                                    <TextBlock x:Name="SubmenuArrow"
                                               Grid.Column="2"
                                               Text="&#x203A;"
                                               FontSize="14"
                                               Foreground="{DynamicResource TextSecondary}"
                                               Visibility="Collapsed"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup"
                                   Placement="Right"
                                   HorizontalOffset="4"
                                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border Background="{DynamicResource BgSecondary}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        Padding="4"
                                        MinWidth="140">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource BgHover}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="HasItems" Value="True">
                                <Setter TargetName="SubmenuArrow" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Separator">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Grid HorizontalAlignment="Stretch">
                            <Border Height="1"
                                Margin="0,4"
                                Background="{DynamicResource BorderBrush}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <local:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>
        <local:BindingActionTitleConverter x:Key="BindingActionTitleConverter"/>
        <local:BindingActionDetailConverter x:Key="BindingActionDetailConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <!-- Titlebar -->
            <RowDefinition Height="*"/>
            <!-- Content -->
            <RowDefinition Height="36"/>
            <!-- Statusbar -->
        </Grid.RowDefinitions>

        <!-- Titlebar -->
        <Border Grid.Row="0" Background="{DynamicResource BgSecondary}"
        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="16,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <Image Source="tray32.ico" Width="18" Height="18" Margin="0,0,8,0"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="MidiMute" FontSize="13" FontWeight="Medium"
                               Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="BypassBtn" Content="{DynamicResource Main.BypassOff}" Margin="0,0,8,0"
                    ToolTip="{DynamicResource Tooltip.Bypass}"
                    Padding="10,4" Click="BypassBtn_Click" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource FlatButton}">
                                <Style.Triggers>
                                    <Trigger Property="Tag" Value="active">
                                        <Setter Property="Background"  Value="{DynamicResource BypassBg}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource BypassFg}"/>
                                        <Setter Property="Foreground"  Value="{DynamicResource BypassFg}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button x:Name="SettingsMenuBtn"
                            Style="{StaticResource FlatButton}"
                            Content="⚙"
                            ToolTip="{DynamicResource Tooltip.Settings}"
                            Padding="10,4"
                            Margin="0,0,8,0"
                            Click="SettingsMenuBtn_Click">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{DynamicResource Menu.ImportSettings}" Click="ImportSettings_Click"/>
                                <MenuItem Header="{DynamicResource Menu.ExportSettings}" Click="ExportSettings_Click"/>
                                <MenuItem x:Name="AutoStartMenuItem"
                                          Header="{DynamicResource Menu.AutoStart}"
                                          ToolTip="{DynamicResource Tooltip.AutoStart}"
                                          IsCheckable="True"
                                          Click="AutoStartMenuItem_Click"/>
                                <MenuItem IsEnabled="False" Padding="0,4">
                                    <MenuItem.Header>
                                        <Border Height="1"
                                                MinWidth="132"
                                                Background="{DynamicResource BorderBrush}"/>
                                    </MenuItem.Header>
                                </MenuItem>
                                <MenuItem Header="{DynamicResource Menu.Theme}">
                                    <MenuItem x:Name="ThemeAutoMenuItem" Header="{DynamicResource Option.Auto}" IsCheckable="True" Click="ThemeAutoMenuItem_Click"/>
                                    <MenuItem x:Name="ThemeDarkMenuItem" Header="{DynamicResource Option.ThemeDark}" IsCheckable="True" Click="ThemeDarkMenuItem_Click"/>
                                    <MenuItem x:Name="ThemeLightMenuItem" Header="{DynamicResource Option.ThemeLight}" IsCheckable="True" Click="ThemeLightMenuItem_Click"/>
                                </MenuItem>
                                <MenuItem Header="{DynamicResource Menu.Language}">
                                    <MenuItem x:Name="LanguageAutoMenuItem" Header="{DynamicResource Option.Auto}" IsCheckable="True" Click="LanguageAutoMenuItem_Click"/>
                                    <MenuItem x:Name="LanguageRussianMenuItem" Header="{DynamicResource Option.LanguageRussian}" IsCheckable="True" Click="LanguageRussianMenuItem_Click"/>
                                    <MenuItem x:Name="LanguageEnglishMenuItem" Header="{DynamicResource Option.LanguageEnglish}" IsCheckable="True" Click="LanguageEnglishMenuItem_Click"/>
                                </MenuItem>
                                <MenuItem IsEnabled="False" Padding="0,4">
                                    <MenuItem.Header>
                                        <Border Height="1"
                                                MinWidth="132"
                                                Background="{DynamicResource BorderBrush}"/>
                                    </MenuItem.Header>
                                </MenuItem>
                                <MenuItem Header="{DynamicResource Menu.About}" Click="AboutMenuItem_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button Style="{StaticResource FlatButton}" Content="⟳"
                    ToolTip="{DynamicResource Tooltip.Refresh}"
                    Padding="10,4" Margin="0,0,8,0" Click="RefreshButton_Click"/>
                    <Button Style="{StaticResource FlatButton}" Content="—"
                    ToolTip="{DynamicResource Tooltip.Minimize}"
                    Padding="10,4" Click="MinimizeBtn_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="{DynamicResource BgSecondary}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <!-- Заголовок сайдбара -->
                    <Border DockPanel.Dock="Top" Padding="14,10">
                        <Grid>
                            <TextBlock x:Name="AppListTitle" Text="{DynamicResource Main.AppListTitle}"
                                       FontSize="10" FontWeight="Medium"
                                       Foreground="{DynamicResource TextSecondary}"
                                       VerticalAlignment="Center"/>
                            <Button x:Name="EditAppListBtn"
                                    Style="{StaticResource FlatButton}"
                                    Content="✎"
                                    ToolTip="{DynamicResource Tooltip.EditApps}"
                                    BorderThickness="0"
                                    Padding="6,3"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Click="EditAppListBtn_Click"/>
                        </Grid>
                    </Border>

                    <!-- Поиск -->
                    <Border DockPanel.Dock="Top" Margin="8,0,8,8">
                        <TextBox x:Name="SearchBox"
                                 Background="{DynamicResource BgCard}"
                                 Foreground="{DynamicResource TextPrimary}"
                                 BorderBrush="{DynamicResource BorderBrush}"
                                 BorderThickness="1" Padding="10,6"
                                 FontSize="12"
                                 TextChanged="SearchBox_TextChanged">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="TextBox">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="6">
                                                    <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </Border>

                    <!-- Список приложений -->
                    <ListBox x:Name="AppListBox"
                             Style="{StaticResource CleanListBox}"
                             ItemContainerStyle="{StaticResource AppListItem}"
                             SelectionChanged="AppListBox_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Цветная точка -->
                                    <Ellipse Grid.Column="0" Width="7" Height="7" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{DynamicResource ActiveGreen}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                                        <Setter Property="Fill" Value="{DynamicResource TextSecondary}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                                        <Setter Property="Fill" Value="{DynamicResource MutedRed}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>

                                    <!-- Иконка процесса -->
                                    <Image Grid.Column="1" Width="20" Height="20"
                   Margin="6,0,0,0" VerticalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality">
                                        <Image.Style>
                                            <Style TargetType="Image">
                                                <Setter Property="Source" Value="{Binding Icon}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>

                                    <!-- Имя процесса -->
                                    <StackPanel Grid.Column="2" Margin="8,0,0,0">
                                        <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="Medium"
                           Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondary}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{Binding Pid, StringFormat='PID {0}'}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                                            <Setter Property="Text" Value="{DynamicResource Main.NotRunning}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>

                                    <!-- Бейдж -->
                                    <Button Grid.Column="3"
                                            BorderThickness="0"
                                            Padding="6,4"
                                            Margin="4,0,2,0"
                                            Tag="{Binding}"
                                            Click="ToggleAppHidden_Click"
                                            IsEnabled="{Binding CanHide}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource FlatButton}">
                                                <Setter Property="Content" Value="👁"/>
                                                <Setter Property="ToolTip" Value="{DynamicResource Tooltip.HideApp}"/>
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsListEditing}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsHidden}" Value="True">
                                                        <Setter Property="Content" Value="⊘"/>
                                                        <Setter Property="ToolTip" Value="{DynamicResource Tooltip.ShowApp}"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding CanHide}" Value="False">
                                                        <Setter Property="Opacity" Value="0.35"/>
                                                        <Setter Property="ToolTip" Value="{DynamicResource Tooltip.MasterCannotHide}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <Border Grid.Column="4" CornerRadius="99" Padding="6,2"
                    VerticalAlignment="Center" Background="{DynamicResource BadgeBg}"
                    Visibility="{Binding Bindings.Count,
                        Converter={StaticResource CountToVisibilityConverter}}">
                                        <TextBlock Text="{Binding Bindings.Count}" FontSize="10"
                           Foreground="{DynamicResource ActiveGreen}"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Main panel -->
            <Grid Grid.Column="1">
                <!-- Пустое состояние -->
                <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="←" FontSize="32" Foreground="{DynamicResource TextSecondary}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource Main.EmptySelectApp}" FontSize="13"
                               Foreground="{DynamicResource TextSecondary}"
                               HorizontalAlignment="Center" Margin="0,8,0,0"/>
                </StackPanel>

                <!-- Детали приложения -->
                <DockPanel x:Name="AppDetail" Visibility="Collapsed">

                    <!-- Шапка с именем и кнопкой mute -->
                    <Border DockPanel.Dock="Top" Padding="20,16"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock x:Name="DetailName" FontSize="16" FontWeight="Medium"
                                           Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock x:Name="DetailMeta" FontSize="12"
                                           Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button x:Name="MuteToggleBtn" Grid.Column="1"
                                    Content="{DynamicResource Main.Mute}" VerticalAlignment="Center"
                                    ToolTip="{DynamicResource Tooltip.ToggleMute}"
                                    Click="MuteToggleBtn_Click">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource FlatButton}">
                                        <Style.Triggers>
                                            <Trigger Property="Tag" Value="muted">
                                                <Setter Property="Background" Value="{DynamicResource MutedBg}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource MutedRed}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource MutedRed}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Громкость -->
                    <Border x:Name="VolumePanel" DockPanel.Dock="Top" Padding="20,14"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Main.VolumeTitle}" FontSize="10" FontWeight="Medium"
                                       Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,10"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="40"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="VolumeSlider" Grid.Column="0"
                                        Minimum="0" Maximum="100" VerticalAlignment="Center"
                                        ValueChanged="VolumeSlider_ValueChanged"/>
                                <TextBlock x:Name="VolumeLabel" Grid.Column="1"
                                           FontSize="12" FontWeight="Medium"
                                           Foreground="{DynamicResource TextPrimary}"
                                           VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Привязки -->
                    <DockPanel DockPanel.Dock="Top" Margin="20,16,20,0">
                        <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Main.BindingsTitle}" FontSize="10" FontWeight="Medium"
                                   Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,12"/>

                        <Button DockPanel.Dock="Bottom" Style="{StaticResource FlatButton}"
                                Content="{DynamicResource Main.AddBinding}" HorizontalAlignment="Left"
                                ToolTip="{DynamicResource Tooltip.AddBinding}"
                                Margin="0,10,0,0" Click="AddBinding_Click"/>

                        <ListBox x:Name="BindingsListBox"
                                 Style="{StaticResource CleanListBox}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderThickness="1" CornerRadius="8"
                                            Padding="14,10" Margin="0,0,0,8">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource BgCard}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMidiActive}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Клавиша -->
                                            <Border Grid.Column="0" Background="{DynamicResource BgSecondary}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1" CornerRadius="6"
                                                    Padding="10,6" Margin="0,0,14,0">
                                                <TextBlock Text="{Binding NoteName}" FontSize="13" FontWeight="Medium"
                                                           Foreground="{DynamicResource TextPrimary}"/>
                                            </Border>

                                            <!-- Действие -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Converter={StaticResource BindingActionTitleConverter}}"
                                                           FontSize="13" FontWeight="Medium"
                                                           Foreground="{DynamicResource TextPrimary}"/>
                                                <TextBlock Text="{Binding Converter={StaticResource BindingActionDetailConverter}}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextSecondary}"
                                                           Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                <Button Style="{StaticResource FlatButton}"
                                                        Content="{DynamicResource Main.EditShort}" BorderThickness="0" Padding="6,4"
                                                        Foreground="{DynamicResource TextSecondary}"
                                                        ToolTip="{DynamicResource Tooltip.EditBinding}"
                                                        Tag="{Binding}"
                                                        Click="EditBinding_Click"/>
                                                <Button Style="{StaticResource FlatButton}"
                                                        Content="✕" BorderThickness="0" Padding="6,4"
                                                        Foreground="{DynamicResource TextSecondary}"
                                                        ToolTip="{DynamicResource Tooltip.RemoveBinding}"
                                                        Tag="{Binding}"
                                                        Click="RemoveBinding_Click"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </DockPanel>
            </Grid>
        </Grid>

        <!-- Statusbar -->
        <Border Grid.Row="2" Background="{DynamicResource BgSecondary}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="MidiStatusDot" Width="8" Height="8">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource ActiveGreen}"/>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock x:Name="MidiStatusLabel" FontSize="12"
                               Margin="6,0,8,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondary}"/>
                    <ComboBox x:Name="MidiDeviceCombo" Width="180" Height="24"
                              FontSize="12"
                              ToolTip="{DynamicResource Tooltip.MidiDevice}"
                              SelectionChanged="MidiDeviceCombo_SelectionChanged"/>
                    <ComboBox x:Name="RestartAudioDeviceCombo" Width="260" Height="24"
                              Margin="8,0,0,0"
                              FontSize="12"
                              DisplayMemberPath="DisplayName"
                              ToolTip="{DynamicResource Tooltip.RestartAudioDevice}"
                              SelectionChanged="RestartAudioDeviceCombo_SelectionChanged"/>
                </StackPanel>
                <TextBlock Grid.Column="1" x:Name="LastKeyLabel" FontSize="12"
                           Foreground="{DynamicResource TextSecondary}"
                           Margin="16,0" TextTrimming="CharacterEllipsis"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" x:Name="TotalBindingsLabel" FontSize="12"
                           Foreground="{DynamicResource TextSecondary}"
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
