<Window x:Class="MidiMute.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource About.Title}" Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True">

    <Window.Resources>
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource BgHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource BgPrimary}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource BgSecondary}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="8,8,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="16,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="tray32.ico" Width="16" Height="16" Margin="0,0,8,0"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="{DynamicResource About.Title}" FontSize="13" FontWeight="Medium"
                                   Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Style="{StaticResource DialogButton}"
                            Content="x"
                            ToolTip="{DynamicResource About.CloseTooltip}"
                            BorderThickness="0"
                            Padding="8,2"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Click="CloseButton_Click"/>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="24">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                    <Image Source="tray32.ico" Width="34" Height="34" Margin="0,0,12,0"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel>
                        <TextBlock Text="MidiMute" FontSize="18" FontWeight="Medium"
                                   Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock x:Name="VersionLabel" FontSize="12"
                                   Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <TextBlock Text="{DynamicResource App.Description}"
                           FontSize="13"
                           Foreground="{DynamicResource TextPrimary}"
                           Margin="0,0,0,16"/>

                <Border Background="{DynamicResource BgCard}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14"
                        Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource About.Settings}"
                                   Foreground="{DynamicResource TextSecondary}" Margin="0,0,12,8"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="SettingsPathLabel"
                                   Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource About.Log}"
                                   Foreground="{DynamicResource TextSecondary}" Margin="0,0,12,8"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="LogPathLabel"
                                   Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="GitHub"
                                   Foreground="{DynamicResource TextSecondary}" Margin="0,0,12,0"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{DynamicResource Common.NotSet}"
                                   Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap"/>
                    </Grid>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Style="{StaticResource DialogButton}"
                            Content="{DynamicResource About.SettingsFolder}"
                            ToolTip="{DynamicResource About.OpenSettingsTooltip}"
                            Margin="0,0,8,0"
                            Click="OpenSettingsFolder_Click"/>
                    <Button Grid.Column="1" Style="{StaticResource DialogButton}"
                            Content="{DynamicResource About.OpenLog}"
                            ToolTip="{DynamicResource About.OpenLogTooltip}"
                            Margin="0,0,8,0"
                            Click="OpenLog_Click"/>
                    <Button Grid.Column="3" Style="{StaticResource DialogButton}"
                            Content="{DynamicResource Common.Close}"
                            ToolTip="{DynamicResource About.CloseTooltip}"
                            Click="CloseButton_Click"/>
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</Window>
